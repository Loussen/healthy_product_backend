# Place at HOSTING ROOT (next to the `public/` folder), e.g.
#   /home/.../public_html/.htaccess
# NOT inside public/.
#
# - Internal rewrite: /path  →  public/path
# - Canonical 301:   /public/path  →  /path

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --- Canonical: only when the *client* asked for /public/... -----------
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+public/([^\s?]*) [NC]
    RewriteRule ^public/(.*)$ https://%{HTTP_HOST}/$1 [R=301,L,NE,QSA]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+public[\s?] [NC]
    RewriteRule ^public/?$ https://%{HTTP_HOST}/ [R=301,L,QSA]

    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_URI} ^/public/(.*)$ [NC]
    RewriteRule ^public/(.*)$ https://%{HTTP_HOST}/$1 [R=301,L,NE,QSA]

    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_URI} ^/public/?$ [NC]
    RewriteRule ^public/?$ https://%{HTTP_HOST}/ [R=301,L,QSA]

    # --- Serve Laravel public/ (internal; browser URL stays clean) --------
    RewriteRule ^$ public/ [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
